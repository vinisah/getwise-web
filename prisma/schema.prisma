generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model SchoolUnit {
  id String @id @default(cuid())
  code String @unique
  name String
  legalName String
  cnpj String
  zipCode String
  address String
  number String
  complement String @default("")
  neighborhood String
  city String
  state String
  phone String
  mobile String @default("")
  email String
  classification String @default("")
  notes String @default("")
  logoUrl String @default("")
  photos String[] @default([])
  partners Json @default("[]")
  consultants String[] @default(["Secretaria", "Outro"])
  isActive Boolean @default(true)
  enrollmentOpen Boolean @default(true)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  courses SchoolUnitCourse[]
  applications PreEnrollment[]
  @@map("school_units")
}

model SchoolUnitCourse {
  schoolUnitId String
  courseId String
  schoolUnit SchoolUnit @relation(fields: [schoolUnitId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@id([schoolUnitId, courseId])
  @@map("school_unit_courses")
}

model PreEnrollment {
  id String @id @default(cuid())
  requestId String @unique
  protocol String @unique
  applicantId String
  schoolUnitId String
  courseId String?
  studentId String?
  studentCpf String
  studentName String
  data Json
  status String @default("PENDING")
  feedback String @default("")
  version Int @default(1)
  reviewedBy String?
  reviewedAt DateTime?
  geographyRequired Boolean @default(false)
  residence Json?
  placementRequests PlacementRequest[]
  enrollment Enrollment?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  applicant User @relation("Applicant", fields: [applicantId], references: [id])
  student User? @relation("ApprovedStudent", fields: [studentId], references: [id])
  schoolUnit SchoolUnit @relation(fields: [schoolUnitId], references: [id])
  course Course? @relation(fields: [courseId], references: [id])
  @@unique([studentCpf, courseId, schoolUnitId])
  @@index([applicantId, createdAt])
  @@index([status, createdAt])
  @@map("pre_enrollments")
}

model PlacementRequest {
  id String @id @default(cuid())
  applicationId String
  applicationVersion Int
  binding String
  snapshot Json
  reason String
  status String @default("PENDING")
  feedback String @default("")
  reviewedBy String?
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  application PreEnrollment @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  @@unique([applicationId, applicationVersion])
  @@index([status, createdAt])
  @@map("placement_requests")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  APPLICANT
}

enum EnrollmentStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  BOLETO
}

enum LessonStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum ContractType {
  CLT
  PJ
  HOURLY
}

enum SalaryPaymentType {
  SALARY
  THIRTEENTH_1
  THIRTEENTH_2
  VACATION
  OTHER
}

enum ExerciseType {
  MULTIPLE_CHOICE
  FILL_IN_BLANK
  TRUE_FALSE
  WRITING
  LISTENING
  WORD_MATCH
  TRANSLATION
  SENTENCE_ORDER
  DICTATION
  PRONUNCIATION
}

enum UnitType {
  READING
  VIDEO
  MIXED
}

enum CEFRLevel {
  A3
  A1
  A2
  B1
  B2
  C1
  C2
}

// ─── Usuários ────────────────────────────────────────────────────────────────

model User {
  isSchoolDirector Boolean @default(false)
  applications PreEnrollment[] @relation("Applicant")
  approvedApplications PreEnrollment[] @relation("ApprovedStudent")
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  password      String?
  role          Role      @default(STUDENT)
  isActive      Boolean   @default(true) // false = login bloqueado (desativado pelo admin)
  uiPrefs       Json?     // preferências de tema/aparência (TweaksPanel); cookie é a fonte ao vivo
  profileId     String?   // RBAC: perfil de acesso (só p/ ADMIN). null = dono (acesso total).
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  studentProfile   StudentProfile?
  enrollments      Enrollment[]
  lessonBookings   LessonBooking[]
  exerciseAttempts ExerciseAttempt[]
  chatSessions     ChatSession[]
  payments         Payment[]

  teacherProfile  TeacherProfile?
  teachingLessons Lesson[]

  financialTransactions FinancialTransaction[]

  unitProgress      UserUnitProgress[]
  certificates      Certificate[]
  videoProgress     UnitVideoProgress[]
  materialDownloads MaterialDownload[]
  notifications     Notification[]
  profile           AccessProfile?      @relation(fields: [profileId], references: [id], onDelete: SetNull)

  // role filtrado em listagens (students/teachers) e KPIs do dashboard; name serve o orderBy junto.
  @@index([role, name])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Perfis ───────────────────────────────────────────────────────────────────

model StudentProfile {
  whatsappOptIn Boolean @default(false)
  cohortId String?
  cohort Cohort? @relation(fields: [cohortId], references: [id])
  id               String          @id @default(cuid())
  userId           String          @unique
  birthDate        DateTime?
  cpf              String?         @unique
  address          String?
  city             String?
  state            String?
  zipCode          String?
  level            CEFRLevel       @default(A1)
  notes            String?         @db.Text
  emergencyContact String?
  xp               Int             @default(0)
  streak           Int             @default(0)
  rank             String          @default("Bronze")
  weeklyGoal       Int             @default(3)
  skills           Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

model TeacherProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  bio            String?  @db.Text
  cpf            String?  @unique
  hourlyRate     Int      @default(0) // centavos (1999 = R$ 19,99)
  certifications String?  @db.Text
  availability   Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("teacher_profiles")
}

// ─── Planos e Matrículas ──────────────────────────────────────────────────────

model Plan {
  id                String   @id @default(cuid())
  name              String
  description       String?  @db.Text
  price             Int      // centavos (1999 = R$ 19,99)
  lessonsPerMonth   Int
  lessonDurationMin Int      @default(50)
  features          Json?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  enrollments Enrollment[]

  @@map("plans")
}

model Enrollment {
  preEnrollmentId String? @unique
  preEnrollment PreEnrollment? @relation(fields: [preEnrollmentId], references: [id])
  id          String           @id @default(cuid())
  studentId   String
  planId      String
  status      EnrollmentStatus @default(ACTIVE)
  startDate   DateTime
  endDate     DateTime?
  contractUrl String?
  discount    Int              @default(0) // centavos (1999 = R$ 19,99)
  notes       String?          @db.Text
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  student  User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id]) // Restrict: não apagar plano com matrículas
  payments Payment[]

  @@index([studentId])
  @@index([planId])
  @@map("enrollments")
}

// ─── Aulas ────────────────────────────────────────────────────────────────────

model Lesson {
  cohortId String?
  cohort Cohort? @relation(fields: [cohortId], references: [id])
  id          String          @id @default(cuid())
  teacherId   String
  title       String
  description String?         @db.Text
  scheduledAt DateTime
  duration    Int             @default(50)
  status      LessonStatus    @default(SCHEDULED)
  meetingUrl  String?
  notes       String?         @db.Text
  level       CEFRLevel       @default(A1)
  maxStudents Int             @default(1)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  teacher   User             @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  bookings  LessonBooking[]
  materials LessonMaterial[]
  exercises Exercise[]

  @@index([teacherId])
  @@map("lessons")
}

model LessonBooking {
  confirmation String @default("PENDING")
  absenceReason String?
  reminderSentAt DateTime?
  responseToken String @unique @default(cuid())
  id        String       @id @default(cuid())
  lessonId  String
  studentId String
  status    LessonStatus @default(SCHEDULED)
  attendance Boolean?
  feedback  String?      @db.Text
  rating    Int?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  lesson  Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([lessonId, studentId])
  @@index([studentId])
  @@map("lesson_bookings")
}

// ─── Material Didático ────────────────────────────────────────────────────────

model LessonMaterial {
  id          String          @id @default(cuid())
  lessonId    String?
  title       String
  description String?
  fileUrl     String
  fileType    String
  fileSize    Int?
  level       CEFRLevel       @default(A1)
  isPublic    Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("lesson_materials")
}

// ─── Exercícios ───────────────────────────────────────────────────────────────

model Exercise {
  id            String          @id @default(cuid())
  lessonId      String?
  unitId        String?
  title         String
  description   String?         @db.Text
  type          ExerciseType    @default(MULTIPLE_CHOICE)
  level         CEFRLevel       @default(A1)
  content       Json
  correctAnswer Json?
  explanation   String?         @db.Text
  points        Int             @default(10)
  order         Int             @default(0)
  isRequired    Boolean         @default(true)
  timeLimit     Int?
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  lesson   Lesson?           @relation(fields: [lessonId], references: [id])
  unit     Unit?             @relation(fields: [unitId], references: [id], onDelete: Cascade)
  attempts ExerciseAttempt[]

  @@index([unitId])
  @@map("exercises")
}

model ExerciseAttempt {
  id          String   @id @default(cuid())
  exerciseId  String
  studentId   String
  answer      Json
  isCorrect   Boolean
  score       Int      @default(0)
  scorePercent Int     @default(0)
  passed      Boolean  @default(false)
  timeSpent   Int?
  createdAt   DateTime @default(now())

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  student  User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, exerciseId])
  @@map("exercise_attempts")
}

// ─── IA Tutor ─────────────────────────────────────────────────────────────────

model ChatSession {
  id        String   @id @default(cuid())
  studentId String
  title     String   @default("Nova conversa")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student  User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([studentId])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String
  content   String   @db.Text
  tokens    Int?
  createdAt DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

// ─── Financeiro ───────────────────────────────────────────────────────────────

model FinancialCategory {
  id        String          @id @default(cuid())
  name      String
  type      TransactionType
  color     String?
  icon      String?
  createdAt DateTime        @default(now())

  // Classificação contábil para o DRE (cascata). Null = "(não classificado)" — entra no
  // demonstrativo num grupo à parte, NUNCA some do total. Validar com o contador.
  dreGroup  DreGroup?
  dreNature DreNature? // fixa/variável — alimenta margem de contribuição e ponto de equilíbrio
  isDas     Boolean   @default(false) // marca a conta do DAS (Simples) — evita dupla contagem de tributos

  transactions FinancialTransaction[]

  @@map("financial_categories")
}

/** Grupos da cascata do DRE (empresa de serviços, perfil Simples Nacional). */
enum DreGroup {
  RECEITA_BRUTA // serviços prestados (mensalidade, matrícula, material vendido)
  DEDUCAO // DAS (Simples), ISS retido, cancelamentos/devoluções — reduz a receita bruta
  CUSTO_SERVICO // CSP: custo direto (professores, material didático aplicado, subcontratação)
  DESPESA_ADMINISTRATIVA // aluguel, contador, software, escritório
  DESPESA_COMERCIAL // comissão, marketing, publicidade
  DESPESA_GERAL // demais despesas operacionais
  RECEITA_FINANCEIRA // juros recebidos, rendimentos
  DESPESA_FINANCEIRA // juros pagos, tarifas bancárias, multas
  DEPRECIACAO // depreciação/amortização — somada de volta para o EBITDA
  IMPOSTO_RENDA // IR/CSLL separado — NO Simples fica 0 (já está dentro do DAS)
}

enum DreNature {
  FIXA
  VARIAVEL
}

model FinancialTransaction {
  id            String          @id @default(cuid())
  categoryId    String?
  userId        String?
  type          TransactionType
  amount        Int             // centavos (1999 = R$ 19,99)
  description   String
  date          DateTime
  dueDate       DateTime?
  isPaid        Boolean         @default(false)
  paidAt        DateTime?
  paymentMethod PaymentMethod?
  isRecurring   Boolean         @default(false) // despesa/receita que repete todo mês
  reference     String?         @unique // idempotência (payment:<id>, salary:<id>, recurring:<src>:<MM/YYYY>)
  notes         String?         @db.Text
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  createdBy     String?

  category FinancialCategory? @relation(fields: [categoryId], references: [id])
  creator  User?              @relation(fields: [createdBy], references: [id])

  // Igualdades (type, isPaid) antes do range (date) — serve melhor os filtros de KPI/DRE.
  @@index([type, isPaid, date])
  @@index([categoryId])
  @@index([createdBy])
  @@map("financial_transactions")
}

model Employee {
  id           String       @id @default(cuid())
  name         String
  email        String?
  phone        String?
  role         String
  cpf          String?      @unique
  salary       Int          // centavos (1999 = R$ 19,99)
  contractType ContractType @default(CLT)
  dependents   Int          @default(0) // dependentes p/ dedução IRRF
  startDate    DateTime
  endDate    DateTime?
  isActive   Boolean   @default(true)
  notes      String?   @db.Text
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  salaryPayments SalaryPayment[]

  @@map("employees")
}

model SalaryPayment {
  id          String            @id @default(cuid())
  employeeId  String
  type        SalaryPaymentType @default(SALARY)
  amount      Int               // LÍQUIDO pago (centavos)
  grossAmount Int               @default(0) // bruto da parcela (centavos)
  inssAmount  Int               @default(0) // INSS retido (centavos)
  irrfAmount  Int               @default(0) // IRRF retido (centavos)
  fgtsAmount  Int               @default(0) // FGTS depositado (centavos)
  month       Int
  year        Int
  isPaid      Boolean           @default(false)
  paidAt      DateTime?
  notes       String?
  createdAt   DateTime          @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month, year, type])
  @@index([employeeId])
  // folha consulta por competência sem employeeId (payroll route/page) → índice dedicado.
  @@index([year, month])
  @@map("salary_payments")
}

// ─── Pagamentos ───────────────────────────────────────────────────────────────

model Payment {
  id             String        @id @default(cuid())
  enrollmentId   String?
  studentId      String
  amount         Int           // centavos — valor da mensalidade (sem multa)
  amountPaid     Int?          // centavos — valor efetivamente recebido (c/ multa+juros); null = não pago
  status         PaymentStatus @default(PENDING)
  method         PaymentMethod?
  chargeId       String?       @unique // id da cobrança no provedor (ex.: Asaas) — idempotência + reconciliação por webhook
  boletoUrl      String?               // link do boleto/fatura (bankSlipUrl/invoiceUrl)
  boletoLine     String?               // linha digitável do boleto
  description    String?
  dueDate        DateTime
  paidAt         DateTime?
  month          Int
  year           Int
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  enrollment Enrollment? @relation(fields: [enrollmentId], references: [id])
  student    User        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([status, dueDate])
  @@index([studentId])
  @@index([enrollmentId])
  @@map("payments")
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  payload   Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Plataforma de Cursos (self-paced) ─────────────────────────────────────────

model Course {
  schoolUnits SchoolUnitCourse[]
  applications PreEnrollment[]
  id          String    @id @default(cuid())
  title       String
  description String?   @db.Text
  level       CEFRLevel
  coverImage  String?
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  modules       Module[]
  prerequisites CoursePrerequisite[] @relation("CourseReq")
  requiredBy    CoursePrerequisite[] @relation("ReqCourse")
  unitProgress  UserUnitProgress[]
  certificates  Certificate[]

  @@map("courses")
}

model Module {
  id          String  @id @default(cuid())
  courseId    String
  title       String
  description String?
  order       Int     @default(0)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  units  Unit[]

  @@index([courseId])
  @@map("modules")
}

model Unit {
  id                   String   @id @default(cuid())
  moduleId             String
  title                String
  content              String   @db.Text
  type                 UnitType @default(READING)
  videoUrl             String?
  thumbnailUrl         String?
  videoDurationSeconds Int?
  durationMinutes      Int?
  order                Int      @default(0)

  module        Module             @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress      UserUnitProgress[]
  exercises     Exercise[]
  materials     UnitMaterial[]
  videoProgress UnitVideoProgress[]

  @@index([moduleId])
  @@map("units")
}

model UnitMaterial {
  id        String   @id @default(cuid())
  unitId    String
  fileName  String
  fileUrl   String
  fileType  String   @default("pdf")
  createdAt DateTime @default(now())

  unit      Unit               @relation(fields: [unitId], references: [id], onDelete: Cascade)
  downloads MaterialDownload[]

  @@index([unitId])
  @@map("unit_materials")
}

model MaterialDownload {
  id           String   @id @default(cuid())
  userId       String
  materialId   String
  downloadedAt DateTime @default(now())

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  material UnitMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([userId, materialId])
  @@map("material_downloads")
}

model UnitVideoProgress {
  id              String   @id @default(cuid())
  userId          String
  unitId          String
  positionSeconds Int      @default(0)
  watchedPercent  Int      @default(0)
  updatedAt       DateTime @updatedAt @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([userId, unitId])
  @@map("unit_video_progress")
}

model CoursePrerequisite {
  id               String @id @default(cuid())
  courseId         String
  requiredCourseId String

  course         Course @relation("CourseReq", fields: [courseId], references: [id], onDelete: Cascade)
  requiredCourse Course @relation("ReqCourse", fields: [requiredCourseId], references: [id])

  @@unique([courseId, requiredCourseId])
  @@map("course_prerequisites")
}

model UserUnitProgress {
  id          String    @id @default(cuid())
  userId      String
  unitId      String
  courseId    String
  completed   Boolean   @default(false)
  completedAt DateTime?
  lastAccess  DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, unitId])
  @@index([userId, courseId])
  @@map("user_unit_progress")
}

model Certificate {
  id             String   @id @default(cuid())
  certificateId  String   @unique
  userId         String
  courseId       String
  studentName    String
  courseName     String
  completionDate DateTime
  createdAt      DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("certificates")
}

enum NotificationType {
  PAYMENT_DUE
  PAYMENT_OVERDUE
  CERTIFICATE_ISSUED
  LESSON_REMINDER
  PAYROLL_PROCESSED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String           @db.Text
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

/**
 * RBAC: perfil de acesso do staff (ADMIN). `sections` = chaves das seções do painel que o
 * perfil pode acessar (ver lib/admin-sections.ts). Usuário sem perfil (profileId null) = dono
 * = acesso total. isSystem marca perfis semeados (não apagáveis pela UI).
 */
model AccessProfile {
  id        String   @id @default(cuid())
  name      String   @unique
  sections  String[]
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  @@map("access_profiles")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@map("email_verification_tokens")
}

model Cohort {
  id String @id @default(cuid())
  name String
  level CEFRLevel
  capacity Int
  createdAt DateTime @default(now())
  students StudentProfile[]
  lessons Lesson[]
}

model WhatsAppEvent {
  id String @id
  createdAt DateTime @default(now())
}
